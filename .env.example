GEMINI_API_KEY=replace-with-your-gemini-key
GROQ_API_KEY=replace-with-your-groq-key
# Optional: override the Groq model without a code change.
# Free tier allows 1000 requests/day and 8000 tokens/minute per model.
GROQ_MODEL=openai/gpt-oss-120b
GITHUB_TOKEN=optional-read-only-github-token-for-higher-rate-limits
